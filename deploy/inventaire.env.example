# Secrets de la collecte planifiee.
#
#   sudo cp deploy/inventaire.env.example /etc/inventaire-infra.env
#   sudo chown root:inventaire /etc/inventaire-infra.env
#   sudo chmod 640 /etc/inventaire-infra.env
#
# Ce fichier est lu par deploy/collecte.sh. Ne le mets pas dans un depot.

# --- OVH : https://api.ovh.com/createToken/ --------------------------------
# Droits : GET /dedicated/server*  et  GET /vps*
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# OVH_ENDPOINT=ovh-eu

# --- Proxmox ---------------------------------------------------------------
# pveum user token add inventory@pve readonly --privsep 0
PVE_TOKEN=inventory@pve!readonly=

# Un token different par cluster se declare dans infra.yml (pve.tokens),
# en renvoyant vers d'autres variables :
# PVE_TOKEN_CLUSTER2=inventory@pve!readonly=

# --- Base ------------------------------------------------------------------
INVENTORY_DB_PASSWORD=
# INVENTORY_DB_HOST=127.0.0.1
# INVENTORY_DB_NAME=inventory
# INVENTORY_DB_USER=inventory
