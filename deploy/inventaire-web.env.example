# Environnement du service web — /etc/inventaire-infra-web.env
#
#   install -m 640 -o root -g inventaire \
#       deploy/inventaire-web.env.example /etc/inventaire-infra-web.env
#
# Volontairement distinct de /etc/inventaire-infra.env, qui porte les clefs
# OVH, les jetons PVE et le mot de passe de la collecte. Le service web n'a
# besoin d'aucun de ces secrets : il lit l'inventaire deja collecte et gere
# les jetons a usage unique. Comme c'est lui qui est joignable depuis le
# reseau a travers Apache, lui donner le reste n'apporterait rien et
# couterait beaucoup.
#
# Une fois deploy/chiffrer-secrets.sh passe, ce fichier n'a plus de raison
# d'etre : le mot de passe arrive par systemd-creds et n'entre jamais dans
# l'environnement du processus.

# Compte de base dedie, sans aucun droit sur secret_store.
# Cree par sql/setup_db.sql.
INVENTORY_DB_USER=inventory_web

# Mot de passe de ce compte — different de celui de la collecte. Deux comptes
# qui partagent un mot de passe ne sont qu'un seul compte avec deux noms.
INVENTORY_DB_PASSWORD=
